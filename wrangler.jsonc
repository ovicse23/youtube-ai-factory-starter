{
  "name": "youtube-ai-factory",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-04-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "youtube-ai-factory-assets"
    }
  ]
  // Optional D1 binding (cloudflare/schema.sql is pre-built and supported natively by cloudflare/worker.js;
  // when a D1 slot is available on your Cloudflare account, uncomment and set database_id):
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "youtube-ai-factory-db",
  //     "database_id": "<YOUR_D1_UUID>"
  //   }
  // ],
  // Phase 3 optional cron trigger for scheduled job queue coordination:
  // "triggers": { "crons": ["0 * * * *"] }
}
